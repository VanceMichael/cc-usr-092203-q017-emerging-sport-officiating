  "facts": [
    "虚拟跆拳道依赖头显与动作追踪系统，按设备型号与漂移阈值验收",
    "板式网球以玻璃墙和出界安全区为关键设施，逐块面板检查",
    "冲浪面对实时海况，浪高、风速、周期按短周期复测",
    "综合格斗涉及围绳、地垫、临场医生与救护车，缺一无开赛条件"
  ],
  "constraints": [
    "不得使用通用验收表，四个项目各有独立清单与标准版本",
    "检查数据与照片必须带采集时间，换件或临时修复只影响对应设施",
    "设备跨场借用、传感器漂移、玻璃损伤、海况突变、救护缺席立即传播到受影响赛程",
    "旧证书不得放行，任何开赛、延迟或取消决定可回溯到标准、证据与签署人"
  ],
